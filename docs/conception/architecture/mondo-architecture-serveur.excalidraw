63451188, "link": null, "locked": false, "strokeColor": "#495057", "backgroundColor": "transparent", "text": "accusés, réponses", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "originalText": "accusés, réponses", "lineHeight": 1.25, "autoResize": true, "index": "ar", "strokeStyle": "solid", "roundness": null, "created": null, "labelPosition": null, "baseFontSize": null, "startBinding": null, "endBinding": null}, {"id": "Vnihb8WxBLmdjryEQXcSH", "type": "text", "x": 60, "y": 566, "width": 492.8, "height": 16.25, "angle": 0, "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 729048109, "version": 1, "versionNonce": 1944641916, "isDeleted": false, "boundElements": [], "updated": 1793663451188, "link": null, "locked": false, "strokeColor": "#495057", "backgroundColor": "transparent", "text": "Trait plein : appel d'un module par un autre. Pointillés : événement interne.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "originalText": "Trait plein : appel d'un module par un autre. Pointillés : événement interne.", "lineHeight": 1.25, "autoResize": true, "index": "ar", "strokeStyle": "solid", "roundness": null, "created": null, "labelPosition": null, "baseFontSize": null, "startBinding": null, "endBinding": null}, {"id": "w3CBkkmL2fSgY5CKFwFnz", "type": "text", "x": 60, "y": 588, "width": 742.4000000000001, "height": 16.25, "angle": 0, "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 617414663, "version": 1, "versionNonce": 1781162256, "isDeleted": false, "boundElements": [], "updated": 1793663451188, "link": null, "locked": false, "strokeColor": "#495057", "backgroundColor": "transparent", "text": "Chaque module ne lit que ses propres tables. Les écritures au registre passent par le connecteur registre, par lots.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "originalText": "Chaque module ne lit que ses propres tables. Les écritures au registre passent par le connecteur registre, par lots.", "lineHeight": 1.25, "autoResize": true, "index": "ar", "strokeStyle": "solid", "roundness": null, "created": null, "labelPosition": null, "baseFontSize": null, "startBinding": null, "endBinding": null}, {"id": "vAD8REByFFit1Gzz2m9xY", "type": "text", "x": 60, "y": 610, "width": 672.0, "height": 16.25, "angle": 0, "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1494123800, "version": 1, "versionNonce": 369675722, "isDeleted": false, "boundElements": [], "updated": 1793663451188, "link": null, "locked": false, "strokeColor": "#495057", "backgroundColor": "transparent", "text": "Les réponses du contact de confiance arrivent par la passerelle et sont transmises à Comptes et identité.", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "baseline": 14, "containerId": null, "originalText": "Les réponses du contact de confiance arrivent par la passerelle et sont transmises à Comptes et identité.", "lineHeight": 1.25, "autoResize": true, "index": "ar", "strokeStyle": "solid", "roundness": null, "created": null, "labelPosition": null, "baseFontSize": null, "startBinding": null, "endBinding": null}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}