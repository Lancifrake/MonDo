u règlement signé" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="240" height="88" as="geometry" /></mxCell><mxCell id="n8_F" value="Décision de l'administrateur : paiement validé, cotisation maintenue due, ou compte débloqué" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="680" width="240" height="106" as="geometry" /></mxCell><mxCell id="n8_G" value="Registre : décision enregistrée" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="340" y="860" width="240" height="70" as="geometry" /></mxCell><mxCell id="n8_H" value="Les membres concernés sont informés par SMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="1160" width="240" height="70" as="geometry" /></mxCell><mxCell id="n8_N" value="L'administrateur ne touche jamais l'argent : il valide ou refuse, les membres règlent par Mobile Money" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="190" y="1300" width="240" height="88" as="geometry" /></mxCell><mxCell id="e8_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="n8_A" target="n8_B"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="n8_B" target="n8_C"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=12;" edge="1" parent="1" source="n8_C" t