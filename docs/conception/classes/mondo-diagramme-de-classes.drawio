><mxCell id="e47" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=8;strokeColor=#7F8C9A;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=none;dashed=1;" edge="1" parent="1" source="c_Cercle" target="c_FondsDeGarantie"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e47_s" value="1" style="edgeLabel;html=1;resizable=0;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;align=left;verticalAlign=bottom;" vertex="1" connectable="0" parent="e47"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="e47_t" value="0..1" style="edgeLabel;html=1;resizable=0;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="e47"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="-6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="e48" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=8;strokeColor=#7F8C9A;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=none;dashed=1;" edge="1" parent="1" source="c_Tour" target="c_RetenueSurPassage"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e48_s" value="1" style="edgeLabel;html=1;resizable=0;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;align=left;verticalAlign=bottom;" vertex="1" connectable="0" parent="e48"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="e48_t" value="0..1" style="edgeLabel;html=1;resizable=0;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="e48"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="-6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="e49" value="" style="html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#FFFFFF;endArrow=none;dashed=1;" edge="1" parent="1" source="c_RetenueSurPassage" target="c_FondsDeGarantie"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e49_s" value="0..*" style="edgeLabel;html=1;resizable=0;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;align=left;verticalAlign=bottom;" vertex="1" connectable="0" parent="e49"><mxGeometry x="-0.85" relative="1" as="geometry"><mxPoint x="6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="e49_t" value="1" style="edgeLabel;html=1;resizable=0;fontSize=10;fontColor=#000000;labelBackgroundColor=#FFFFFF;align=right;verticalAlign=bottom;" vertex="1" connectable="0" parent="e49"><mxGeometry x="0.85" relative="1" as="geometry"><mxPoint x="-6" y="-4" as="offset"/></mxGeometry></mxCell><mxCell id="legende" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;Bleu : classe du domaine&lt;br&gt;Jaune «calculé» : jamais stockée, recalculée&lt;br&gt;Vert «interface» : contrat des agents&lt;br&gt;Gris pointillé «V2» : phase 2&lt;br&gt;Violet «enumeration» : types&lt;br&gt;Losange plein : composition (la partie n'existe pas sans le tout)&lt;br&gt;Triangle creux pointillé : réalisation d'interface&lt;br&gt;Flèche ouverte pointillée : dépendance&lt;br&gt;Trait gris : association entre paquetages" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#999999;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2965" y="1588" width="488" height="200" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Note&lt;/b&gt;&lt;br&gt;Entre paquetages, les associations passent &lt;b&gt;par identifiant&lt;/b&gt; dans le code : un schéma PostgreSQL par module, aucune clé étrangère entre schémas (décision 02).&lt;br&gt;&lt;br&gt;Pas encore dans le code (04/11) : CleSignature (attribut du compte), DocumentSigne (sur l'adhésion), Tour, PieceIdentite, ContactConfiance, DemandeRecuperation, EchangePlace, Litige, Administrateur.&lt;br&gt;&lt;br&gt;Source : docs/conception/diagramme-de-classes.md. Le fichier Visual Paradigm fait foi une fois dessiné." style="shape=note;whiteSpace=wrap;html=1;size=16;align=left;verticalAlign=top;spacing=10;fillColor=#FFFDE7;strokeColor=#B7A100;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2965" y="1818" width="488" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>