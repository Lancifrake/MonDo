{
  "name": "@mondo/serveur",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "essai-demarrage": "node scripts/essai-demarrage.mjs",
    "test": "vitest run",
    "verifier-types": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verifier-format": "prettier --check .",
    "couverture": "vitest run --coverage",
    "qualite": "eslint . && tsc --noEmit && prettier --check . && vitest run --coverage"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "2.57.14",
    "zod": "^4.6.7"
  }
}
